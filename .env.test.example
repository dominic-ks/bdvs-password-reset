# Copy this to .env.test and fill in values for local integration testing.
# The Docker Compose setup passes these as container environment variables.
# For local/manual runs against an already-running WP, set these here.

WP_BASE_URL=http://localhost:8080
TEST_DB_HOST=127.0.0.1
TEST_DB_NAME=wordpress
TEST_DB_USER=wordpress
TEST_DB_PASSWORD=wordpress
WP_ADMIN_EMAIL=admin@bdpwr.test
WP_ADMIN_PASSWORD=AdminPass123!
TEST_SUBSCRIBER_EMAIL=subscriber@bdpwr.test
TEST_SUBSCRIBER_PASSWORD=SubscriberPass123!
